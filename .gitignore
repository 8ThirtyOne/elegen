lcmodel/configMail.php
.env
.env.*
php.ini
.user.ini

# ------------------------------------------------------------------
# Uploaded / dynamic content (managed through the admin panel)
# Directory structure is kept via .gitkeep, files are ignored.
# ------------------------------------------------------------------
public_html/files/**
!public_html/files/**/
!public_html/files/**/.gitkeep

# Regenerated by admin/includes/sitemap-update.php on publish/delete
public_html/sitemap.xml

